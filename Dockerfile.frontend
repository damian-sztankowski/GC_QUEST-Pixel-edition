
FROM node:20-alpine AS builder

WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .

# DECLARE ARGS HERE so they are available to the RUN command
ARG VITE_BACKEND_URL
ARG VITE_HANDSHAKE_SECRET

# Map them to ENV vars for the build process
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_HANDSHAKE_SECRET=$VITE_HANDSHAKE_SECRET

RUN npm run build

FROM node:20-alpine

WORKDIR /app

COPY package.json ./
RUN npm install express helmet

COPY --from=builder /app/dist ./dist
COPY frontend_host.js ./

ENV PORT=8080
EXPOSE 8080

CMD ["node", "frontend_host.js"]
